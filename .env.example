# Select the data environment. The dashboard displays this value.
ENVIRONMENT=staging

# MySQL read-only connection
MYSQL_PORT=3306
MYSQL_DATABASE=curation_engine
MYSQL_USER=ce_test_rig_reader
MYSQL_PASSWORD=
MYSQL_SSL_CA=/absolute/path/to/DigiCertGlobalRootG2.crt.pem

# Azure Blob access
AUDIT_BLOB_CONTAINER=pipeline-audit
AZURE_STORAGE_KEY=

# Jev provider: typesafe or openrouter
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenRouter Jev alternative
OPENROUTER_API_KEY=
OPENROUTER_JEV_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_APP_TITLE=jev-curation-engine
OPENROUTER_USER_AGENT=jev-curation-engine-benchmark/1.0
OPENROUTER_HTTP_REFERER=http://localhost:3000
# Optional Gemini prompt optimizer. Leave disabled until a key is available.
GEMINI_API_KEY=
GEMINI_OPTIMIZER_MODEL=gemini-2.5-flash
PROMPT_OPTIMIZATION_ENABLED=false
