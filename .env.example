# Select the data environment. The dashboard displays this value.
ENVIRONMENT=staging

# MySQL read-only connection
MYSQL_PORT=3306
MYSQL_DATABASE=curation_engine
MYSQL_USER=ce_test_rig_reader
MYSQL_PASSWORD=
MYSQL_SSL_CA=/absolute/path/to/DigiCertGlobalRootG2.crt.pem

# Azure Blob access
AUDIT_BLOB_CONTAINER=pipeline-audit
AZURE_STORAGE_KEY=

# TypeSafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional baseline cost controls
LLM_FLAT_COST_PER_ARTICLE_USD=0.007
